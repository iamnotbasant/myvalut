{
  "manifest_version": 3,
  "name": "Valut - AI Bookmark Vault",
  "version": "1.0.0",
  "description": "1-Click bookmarking with instant AI auto-tagging for YouTube, X (Twitter), Instagram, Reddit, and Web.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Valut - Save & Auto-Tag with AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/toast.js",
        "content/youtube.js"
      ],
      "css": [
        "content/toast.css",
        "content/youtube.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.twitter.com/*",
        "*://*.x.com/*"
      ],
      "js": [
        "content/toast.js",
        "content/twitter.js"
      ],
      "css": [
        "content/toast.css",
        "content/twitter.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "content/toast.js",
        "content/instagram.js"
      ],
      "css": [
        "content/toast.css",
        "content/instagram.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.reddit.com/*"
      ],
      "js": [
        "content/toast.js",
        "content/reddit.js"
      ],
      "css": [
        "content/toast.css",
        "content/reddit.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/toast.js",
        "content/generic.js"
      ],
      "css": [
        "content/toast.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Save current page to Valut with AI Tags"
    }
  }
}
